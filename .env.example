# ============================================================
# SabakHub — Environment Variables
# ============================================================
# Copy this file as:
#   .env.staging    — for local dev pointing at staging Firebase
#   .env.production — for local dev pointing at production Firebase
#   .env            — default (typically = staging)
#
# In Netlify: set these in Site settings → Environment variables
# ============================================================

# ---- Firebase Client SDK (frontend, VITE_ prefix) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ---- Firebase Admin SDK (Netlify Functions, server-side) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- AI Provider ----
GEMINI_API_KEY=

# ---- Payment Provider (Finik.kg) ----
FINIK_API_KEY=
FINIK_SECRET_KEY=
FINIK_API_URL=https://api.finik.kg
FINIK_TESTING=true
# Legacy FreedomPay (being replaced):
# FREEDOMPAY_MERCHANT_ID=
# FREEDOMPAY_SECRET_KEY=
# FREEDOMPAY_API_URL=
# FREEDOMPAY_TESTING=true

# ---- Telegram (глобальный бот @sabakhub_bot) ----
# Токен из @BotFather. Читается ТОЛЬКО отсюда — запасного значения в коде нет:
# пока переменная пуста, все отправки в Telegram пропускаются с ошибкой в логе.
# Никогда не коммитьте настоящий токен — ни сюда, ни в исходники.
TELEGRAM_BOT_TOKEN=
# Необязательный — значение по умолчанию указано:
# TELEGRAM_BOT_USERNAME=sabakhub_bot
# Секрет вебхука: Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token
# каждого обновления, а вебхук отбрасывает всё, что пришло без него, — иначе любой
# POST на публичный адрес выдаёт себя за чужой chat.id. Тоже только из окружения.
# 32–256 символов A-Z a-z 0-9 _ - (например, `openssl rand -hex 32`). Пока он пуст,
# вебхук не принимает ни одного обновления, а setWebhook не вызывается.
# Ботам организаций (?orgId=) достаётся производный от него секрет — хранить нечего.
# После смены секрета вебхуки нужно зарегистрировать заново.
TELEGRAM_WEBHOOK_SECRET=
# Переходный режим на время перерегистрации вебхуков: обновления без верного
# секрета не отбрасываются, а только пишутся в лог. Не оставлять включённым.
# TELEGRAM_WEBHOOK_REPORT_ONLY=true

# ---- WhatsApp Cloud API (напоминания об оплате) ----
# Запасной канал: сообщение уходит только тем, у кого не привязан Telegram.
# Пока WHATSAPP_TOKEN или WHATSAPP_PHONE_NUMBER_ID пусты, канал выключен
# целиком и ни одного запроса наружу не делает.
# Токен из панели Meta живёт ~24 часа — для боевой работы нужен постоянный,
# от системного пользователя в Business Manager.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Необязательные — значения по умолчанию указаны:
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_DEFAULT_COUNTRY=996
# WHATSAPP_PAYMENT_TEMPLATE=payment_reminder_ru
# WHATSAPP_TEMPLATE_LANG=ru

# ---- Error Tracking (Sentry) ----
VITE_SENTRY_DSN=
VITE_APP_VERSION=0.1.0

